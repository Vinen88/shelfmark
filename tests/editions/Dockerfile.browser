FROM mcr.microsoft.com/playwright:v1.56.1-noble
WORKDIR /frontend
COPY src/frontend/package*.json ./
RUN npm ci --ignore-scripts && npm install --no-save --package-lock=false playwright@1.56.1
COPY src/frontend/ ./
# Mount a reviewed test script at /frontend/check.mjs. Chromium and Vite only
# communicate over loopback; execute this image with --network none.
CMD ["node", "/frontend/check.mjs"]
