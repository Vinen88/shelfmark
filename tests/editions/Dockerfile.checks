ARG SHELFMARK_IMAGE=shelfmark-fork-validation:local
FROM ${SHELFMARK_IMAGE}
COPY --from=ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 /uv /usr/local/bin/uv
# Keep test tools away from the real entrypoint's fixed /app/.venv paths:
# upstream's entrypoint tests must find their stub gunicorn through PATH.
ENV UV_PROJECT_ENVIRONMENT=/opt/checks
RUN uv sync --locked --extra browser && rm -rf /app/.venv
ENV PATH=/opt/checks/bin:$PATH PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
ENTRYPOINT []
