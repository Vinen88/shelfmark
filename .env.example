# Copy to private .env. Defaults use isolated scratch paths and port 18084.
SHELFMARK_PROJECT=shelfmark-fork-lab
SHELFMARK_CONTAINER_NAME=shelfmark-fork-lab
SHELFMARK_IMAGE=shelfmark-fork:local
SHELFMARK_ENV_FILE=.env
SHELFMARK_BIND_ADDRESS=127.0.0.1
SHELFMARK_PORT=18084
SHELFMARK_CONFIG_ROOT=./.local/run/config
SHELFMARK_BOOKS_ROOT=./.local/run/books
SHELFMARK_MEDIA_ROOT=./.local/run/media
SHELFMARK_DOWNLOADS_ROOT=./.local/run/downloads
PUID=1000
PGID=1000
TZ=UTC
# Keep application/catalog/client credentials in the private native config.
# The existing installation's .env stays private and must never be overwritten.
